  function loadMech(mech) {
    currentMech = mech;
    stages = getMechData(mech);
    stage = 0;
    stageProgress = 0;
    applyStage(0);
    updateModeUI();
    updateNarration();
  }

  function applyStage(idx) {
    if (idx < 0) idx = 0;
    if (idx >= stages.length) idx = stages.length - 1;
    stage = idx;
    const s = stages[idx];
    atoms = JSON.parse(JSON.stringify(s.atoms));
    bonds = JSON.parse(JSON.stringify(s.bonds));
    arrows = JSON.parse(JSON.stringify(s.arrows || []));
    charges = atoms.filter(a => a.charge && a.charge !== 0).map(a => ({ id: a.id, charge: a.charge }));
    stageLabel.textContent = s.label;
    mechDesc.textContent = s.narr;
    narrationText.textContent = s.narr;
    narrationBar.querySelector('i').textContent = 'TAHAP ' + (idx + 1);
    if (currentMech === 'sn1') {
      mechStatus.textContent = 'Mekanisme: SN1 (bertahap)';
      energyInfo.textContent = 'ΔG‡ tinggi · intermediat karbokation';
    } else if (currentMech === 'sn2') {
      mechStatus.textContent = 'Mekanisme: SN2 (concerted)';
      energyInfo.textContent = 'Satu puncak · keadaan transisi';
    } else if (currentMech === 'se1') {
      mechStatus.textContent = 'Mekanisme: SE1 (bertahap)';
      energyInfo.textContent = 'Intermediat karbanion';
    } else if (currentMech === 'se2') {
      mechStatus.textContent = 'Mekanisme: SE2 (concerted)';
      energyInfo.textContent = 'Satu puncak · tanpa intermediat';
    }
    drawScene();
  }

  function updateModeUI() {
    modeBtns.forEach(b => b.classList.toggle('active', b.dataset.mech === currentMech));
  }

  function updateNarration() {
    if (stage < stages.length) {
      narrationText.textContent = stages[stage].narr;
      narrationBar.querySelector('i').textContent = 'TAHAP ' + (stage + 1);
    }
  }

  function drawScene() {
    const bg = ctx.createLinearGradient(0, 0, 0, H);
    bg.addColorStop(0, '#f2faff');
    bg.addColorStop(0.5, '#dff0fb');
    bg.addColorStop(1, '#b8d6ec');
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, W, H);

    ctx.strokeStyle = 'rgba(150,190,220,0.12)';
    ctx.lineWidth = 1;
    for (let x = 0; x < W; x += 60) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
    for (let y = 0; y < H; y += 60) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }

    ctx.font = 'bold 26px "Segoe UI"';
    ctx.fillStyle = '#0e3a55';
    ctx.shadowColor = 'rgba(255,255,255,0.9)';
    ctx.shadowBlur = 10;
    ctx.fillText(mechLabel(currentMech), 40, 60);
    ctx.shadowBlur = 0;

    bonds.forEach(b => drawBond(b));
    atoms.forEach(a => drawAtom(a));
    (stages[stage].lp || []).forEach(lp => drawLonePairs(lp));
    arrows.forEach(arr => drawArrow(arr));
    charges.forEach(c => drawCharge(c));

    ctx.font = 'bold 16px "Segoe UI"';
    ctx.fillStyle = '#1e4a68';
    ctx.textAlign = 'center';
    ctx.fillText('Tahap ' + (stage + 1) + ' dari ' + stages.length, W/2, H - 30);
    ctx.textAlign = 'left';
  }

  function mechLabel(m) {
    return { sn1: 'SN1 — Substitusi Nukleofilik Unimolekuler',
             sn2: 'SN2 — Substitusi Nukleofilik Bimolekuler',
             se1: 'SE1 — Substitusi Elektrofilik Unimolekuler',
             se2: 'SE2 — Substitusi Elektrofilik Bimolekuler' }[m] || m;
  }

  function drawAtom(a) {
    const col = ATOM_COLORS[a.el] || ATOM_COLORS.C;
    const r = atomRadius(a.el);

    ctx.beginPath();
    ctx.arc(a.x + 3, a.y + 4, r, 0, Math.PI*2);
    ctx.fillStyle = 'rgba(10,30,50,0.25)';
    ctx.fill();

    const g = ctx.createRadialGradient(a.x - r*0.35, a.y - r*0.35, r*0.1, a.x, a.y, r*1.1);
    g.addColorStop(0, col.light);
    g.addColorStop(0.5, col.fill);
    g.addColorStop(1, col.edge);
    ctx.beginPath();
    ctx.arc(a.x, a.y, r, 0, Math.PI*2);
    ctx.fillStyle = g;
    ctx.shadowColor = col.edge + '88';
    ctx.shadowBlur = 16;
    ctx.fill();
    ctx.shadowBlur = 0;

    ctx.beginPath();
    ctx.arc(a.x - r*0.35, a.y - r*0.35, r*0.3, 0, Math.PI*2);
    ctx.fillStyle = 'rgba(255,255,255,0.55)';
    ctx.fill();

    ctx.beginPath();
    ctx.arc(a.x, a.y, r, 0, Math.PI*2);
    ctx.strokeStyle = 'rgba(255,255,255,0.4)';
    ctx.lineWidth = 2;
    ctx.stroke();

    ctx.font = 'bold ' + (a.label ? Math.max(11, r*0.75) : Math.max(12, r*0.9)) + 'px "Segoe UI"';
    ctx.fillStyle = (a.el === 'H' || a.el === 'F') ? '#1a2a38' : '#ffffff';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    const txt = a.label || a.el;
    ctx.shadowColor = 'rgba(0,0,0,0.4)';
    ctx.shadowBlur = 3;
    ctx.fillText(txt, a.x, a.y + 1);
    ctx.shadowBlur = 0;
    ctx.textAlign = 'left';
    ctx.textBaseline = 'alphabetic';
  }

  function drawBond(b) {
    const A = atoms.find(a => a.id === b.a);
    const B = atoms.find(a => a.id === b.b);
    if (!A || !B) return;

    const dx = B.x - A.x, dy = B.y - A.y;
    const len = Math.hypot(dx, dy);
    if (len < 1) return;
    const ux = dx/len, uy = dy/len;
    const rA = atomRadius(A.el), rB = atomRadius(B.el);
    const x1 = A.x + ux * rA, y1 = A.y + uy * rA;
    const x2 = B.x - ux * rB, y2 = B.y - uy * rB;

    ctx.save();
    if (b.type === 'dashed') {
      ctx.setLineDash([8, 6]);
      ctx.strokeStyle = 'rgba(80,80,80,0.7)';
      ctx.lineWidth = 4;
    } else {
      ctx.strokeStyle = '#4a4a4a';
      ctx.lineWidth = 6;
    }
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
    ctx.setLineDash([]);

    if (b.type !== 'dashed') {
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x2, y2);
      ctx.strokeStyle = 'rgba(255,255,255,0.35)';
      ctx.lineWidth = 2;
      ctx.stroke();
    }
    ctx.restore();
  }

  function drawLonePairs(lp) {
    const atom = atoms.find(a => a.id === lp.id);
    if (!atom) return;
    const r = atomRadius(atom.el);
    for (let i = 0; i < lp.count; i++) {
      const ang = (i * 1.2 + 0.3) - Math.PI/2;
      const px = atom.x + Math.cos(ang) * (r + 8);
      const py = atom.y + Math.sin(ang) * (r + 8);
      ctx.beginPath();
      ctx.arc(px - 4, py, 3.5, 0, Math.PI*2);
      ctx.fillStyle = '#2a7be0';
      ctx.shadowColor = '#2a7be0';
      ctx.shadowBlur = 8;
      ctx.fill();
      ctx.beginPath();
      ctx.arc(px + 4, py, 3.5, 0, Math.PI*2);
      ctx.fill();
      ctx.shadowBlur = 0;
    }
  }

  function drawArrow(arr) {
    let fromPos = null, toPos = null;
    if (arr.from.includes('-')) {
      const [a, b] = arr.from.split('-');
      const A = atoms.find(x => x.id === a);
      const B = atoms.find(x => x.id === b);
      if (A && B) fromPos = { x: (A.x + B.x)/2, y: (A.y + B.y)/2 };
    } else {
      const A = atoms.find(x => x.id === arr.from);
      if (A) fromPos = { x: A.x, y: A.y };
    }
    if (arr.to.includes('-')) {
      const [a, b] = arr.to.split('-');
      const A = atoms.find(x => x.id === a);
      const B = atoms.find(x => x.id === b);
      if (A && B) toPos = { x: (A.x + B.x)/2, y: (A.y + B.y)/2 };
    } else {
      const B = atoms.find(x => x.id === arr.to);
      if (B) toPos = { x: B.x, y: B.y };
    }
    if (!fromPos || !toPos) return;

    const dx = toPos.x - fromPos.x, dy = toPos.y - fromPos.y;
    const len = Math.hypot(dx, dy);
    if (len < 10) return;
    const mx = (fromPos.x + toPos.x)/2 + dy*0.22;
    const my = (fromPos.y + toPos.y)/2 - dx*0.22;

    ctx.save();
    ctx.strokeStyle = '#e63946';
    ctx.fillStyle = '#e63946';
    ctx.lineWidth = 4;
    ctx.shadowColor = '#e63946';
    ctx.shadowBlur = 10;

    ctx.beginPath();
    ctx.moveTo(fromPos.x, fromPos.y);
    ctx.quadraticCurveTo(mx, my, toPos.x, toPos.y);
    ctx.stroke();

    const t = 0.92;
    const tanX = 2*(1-t)*(mx - fromPos.x) + 2*t*(toPos.x - mx);
    const tanY = 2*(1-t)*(my - fromPos.y) + 2*t*(toPos.y - my);
    const ang = Math.atan2(tanY, tanX);
    const aSize = 14;
    ctx.beginPath();
    ctx.moveTo(toPos.x, toPos.y);
    ctx.lineTo(toPos.x - aSize*Math.cos(ang - 0.4), toPos.y - aSize*Math.sin(ang - 0.4));
    ctx.lineTo(toPos.x - aSize*Math.cos(ang + 0.4), toPos.y - aSize*Math.sin(ang + 0.4));
    ctx.closePath();
    ctx.fill();

    ctx.beginPath();
    ctx.arc(fromPos.x, fromPos.y, 5, 0, Math.PI*2);
    ctx.fill();
    ctx.restore();
  }

  function drawCharge(c) {
    const a = atoms.find(x => x.id === c.id);
    if (!a) return;
    const r = atomRadius(a.el);
    const px = a.x + r*0.85, py = a.y - r*0.85;
    ctx.font = 'bold 20px "Segoe UI"';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillStyle = c.charge > 0 ? '#e63946' : '#2a7be0';
    ctx.shadowColor = 'rgba(255,255,255,0.9)';
    ctx.shadowBlur = 6;
    const sym = c.charge > 0 ? '+' : '−';
    ctx.fillText(sym, px, py);
    ctx.shadowBlur = 0;
    ctx.textAlign = 'left';
    ctx.textBaseline = 'alphabetic';
  }

  function animate(ts) {
    if (!animating || paused) { raf = null; return; }
    if (!lastTs) lastTs = ts;
    let dt = Math.min(0.05, (ts - lastTs)/1000) * speedFactor;
    lastTs = ts;
    tick += dt * 60;

    stageProgress += dt / STAGE_DURATION;
    if (stageProgress >= 1) {
      if (stage < stages.length - 1) {
        applyStage(stage + 1);
        stageProgress = 0;
        updateNarration();
      } else {
        stageProgress = 1;
        animating = false;
        startBtn.disabled = false;
        pauseBtn.disabled = true;
        narrationText.textContent = 'Simulasi selesai. Tekan ULANGI untuk mengulang.';
        narrationBar.querySelector('i').textContent = 'SELESAI';
      }
    }
    drawScene();
    raf = requestAnimationFrame(animate);
  }

  modeBtns.forEach(b => {
    b.addEventListener('click', () => {
      if (animating) {
        animating = false; paused = false;
        if (raf) cancelAnimationFrame(raf); raf = null;
        startBtn.disabled = false;
        pauseBtn.disabled = false;
        pauseBtn.textContent = '⏸ JEDA';
      }
      loadMech(b.dataset.mech);
      infoPopup.textContent = 'Mekanisme: ' + b.dataset.mech.toUpperCase();
    });
  });

  startBtn.addEventListener('click', () => {
    if (!animating) {
      animating = true; paused = false;
      lastTs = 0;
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(animate);
      startBtn.disabled = true;
      pauseBtn.disabled = false;
      infoPopup.textContent = 'Simulasi berjalan...';
    }
  });

  pauseBtn.addEventListener('click', () => {
    if (animating && !paused) {
      paused = true;
      pauseBtn.textContent = '▶ LANJUT';
      infoPopup.textContent = 'Dijeda';
    } else if (paused) {
      paused = false; lastTs = 0;
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(animate);
      pauseBtn.textContent = '⏸ JEDA';
      infoPopup.textContent = 'Melanjutkan...';
    }
  });

  resetBtn.addEventListener('click', () => {
    if (raf) cancelAnimationFrame(raf); raf = null;
    animating = false; paused = false;
    stageProgress = 0;
    applyStage(0);
    updateNarration();
    startBtn.disabled = false;
    pauseBtn.disabled = false;
    pauseBtn.textContent = '⏸ JEDA';
    infoPopup.textContent = 'Simulasi diulang';
  });

  stepBack.addEventListener('click', () => {
    if (raf) cancelAnimationFrame(raf); raf = null;
    animating = false; paused = false;
    startBtn.disabled = false;
    pauseBtn.disabled = false;
    applyStage(Math.max(0, stage - 1));
    updateNarration();
  });

  stepFwd.addEventListener('click', () => {
    if (raf) cancelAnimationFrame(raf); raf = null;
    animating = false; paused = false;
    startBtn.disabled = false;
    pauseBtn.disabled = false;
    applyStage(Math.min(stages.length - 1, stage + 1));
    updateNarration();
  });

  speedUp.addEventListener('click', () => {
    speedFactor = Math.min(3.0, +(speedFactor + 0.3).toFixed(1));
    speedLabel.textContent = speedFactor.toFixed(1) + 'x';
  });
  speedDown.addEventListener('click', () => {
    speedFactor = Math.max(0.3, +(speedFactor - 0.3).toFixed(1));
    speedLabel.textContent = speedFactor.toFixed(1) + 'x';
  });

  canvas.addEventListener('click', (e) => {
    const rect = canvas.getBoundingClientRect();
    const scaleX = canvas.width / rect.width;
    const scaleY = canvas.height / rect.height;
    const mx = (e.clientX - rect.left) * scaleX;
    const my = (e.clientY - rect.top) * scaleY;

    for (let a of atoms) {
      const r = atomRadius(a.el);
      if (Math.hypot(mx - a.x, my - a.y) < r) {
        const el = a.el;
        const val = { C: 4, H: 1, O: 6, N: 5, Br: 7, Cl: 7, Mg: 2, I: 7, F: 7 }[el] || '?';
        atomInfo.innerHTML = `<b>${a.label || el}</b> · Valensi ${val} · Muatan formal: <b style="color:${a.charge>0?'#e63946':a.charge<0?'#2a7be0':'#0e3a55'}">${a.charge>0?'+'+a.charge:a.charge<0?a.charge:'0'}</b> · Pasangan bebas: ${(stages[stage].lp||[]).filter(l=>l.id===a.id).reduce((s,l)=>s+l.count,0)}`;
        infoPopup.textContent = `Atom ${el} dipilih`;
        return;
      }
    }

    for (let b of bonds) {
      const A = atoms.find(x => x.id === b.a);
      const B = atoms.find(x => x.id === b.b);
      if (!A || !B) continue;
      const mxB = (A.x + B.x)/2, myB = (A.y + B.y)/2;
      if (Math.hypot(mx - mxB, my - myB) < 22) {
        atomInfo.innerHTML = `<b>Ikatan ${A.label||A.el}–${B.label||B.el}</b> · Tipe: ${b.type === 'dashed' ? 'sedang terbentuk/terputus' : 'kovalen tunggal'} · Polaritas: ${A.el === B.el ? 'nonpolar' : 'polar'}`;
        infoPopup.textContent = 'Ikatan dipilih';
        return;
      }
    }

    infoPopup.textContent = 'Klik atom/ikatan untuk info';
  });

  loadMech('sn1');
})();
</script>
</body>
